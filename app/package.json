{
  "name": "job-search-console-app",
  "version": "0.0.0",
  "description": "Local web console for job-search-console: server, agent runner, skills layer, and UI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "start": "npm --prefix ui run build && node server/index.js",
    "dev": "node --watch server/index.js",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "build": "npm --prefix ui run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^16.0.0",
    "pino-pretty": "^13.1.3"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.1",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.1",
    "sanitize-html": "^2.17.7"
  }
}
